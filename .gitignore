# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class

# Build and packaging output (setuptools, PyInstaller)
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.python-version

# Test, coverage and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local Claude Code settings (shared settings in .claude/settings.json stay tracked)
.claude/settings.local.json

# Scratch
*.tmp
*.log
